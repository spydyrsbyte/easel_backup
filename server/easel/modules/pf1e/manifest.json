{
  "type": "module",
  "owner": "easel",
  "host": "pf1e",
  "name": "rules",
  "version": {
    "major": 0,
    "minor": 1,
    "revision": 0
  },
  "server": {
    "library": {
      "entry": "server/library.mjs",
      "required": {
        "modules": [
          "easel.vtt.table"
        ]
      }
    },
    "security": {
      "entry": "server/security.mjs"
    },
    "interfaces": [
      {
        "name": "statblock@1",
        "file": "server/statblock.mjs"
      },
      {
        "name": "game@1",
        "file": "server/game.mjs"
      }
    ],
    "data": [
      {
        ".file": "data/schemas.json"
      }
    ]
  },
  "client": {
    "interfaces": [
      {
        "name": "charactersheet@1",
        "file": "interfaces/charactersheet.json",
        "http-entry": "client/charactersheet.mjs",
        "required": {
          "interfaces": [
            "easel.layout.tabs@1",
            "easel.d20.abilityblock@1",
            "easel.d20.defensebanner@1",
            "easel.d20.vitality@1",
            "easel.d20.spellbook@1",
            "easel.d20.equipmentslots@1",
            "easel.rules.modifierlist@1",
            "easel.narrative.richtext@1"
          ]
        }
      },
      {
        "name": "npcsheet@1",
        "file": "interfaces/npcsheet.json",
        "http-entry": "client/npcsheet.mjs",
        "required": {
          "interfaces": [
            "easel.pf1e.charactersheet@1",
            "easel.d20.vitality@1",
            "easel.d20.defensebanner@1"
          ]
        }
      },
      {
        "name": "recordeditor@1",
        "file": "interfaces/recordeditor.json",
        "http-entry": "client/recordeditor.mjs",
        "required": {
          "interfaces": [
            "easel.narrative.richtext@1",
            "easel.layout.tabs@1"
          ]
        }
      },
      {
        "name": "controller@1",
        "file": "interfaces/controller.json",
        "http-entry": "client/controller.mjs",
        "required": {
          "interfaces": [
            "easel.layout.vttworkspace@1",
            "easel.layout.toolstrip@1",
            "easel.layout.tabs@1",
            "easel.layout.window@1",
            "easel.pf1e.charactersheet@1",
            "easel.pf1e.npcsheet@1",
            "easel.pf1e.recordeditor@1",
            "easel.d20.rolldialog@1",
            "easel.maps.map@1",
            "easel.dice.dicebox@1",
            "easel.dice.dicesettings@1",
            "easel.combat.encounter@1",
            "easel.narrative.chatlog@1",
            "easel.collections.directory@1",
            "easel.collections.compendium@1"
          ]
        }
      }
    ],
    "assets": {
      "http": [
        "client/"
      ]
    }
  }
}
