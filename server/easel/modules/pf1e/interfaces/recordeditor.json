{
  "kind": "component",
  "properties": {
    "title": { "type": "String", "default": "Record Editor" },
    "recordType": { "type": "String", "default": "Item" },
    "record": { "type": "Object", "default": {} },
    "actions": { "type": "Array", "default": [] },
    "isGM": { "type": "Boolean", "default": false },
    "activeTab": { "type": "String", "default": "description" },
    "disabled": { "type": "Boolean", "default": false },
    "open": { "type": "Boolean", "default": true }
  },
  "events": {
    "close": { "payload": {} },
    "save": { "payload": { "recordType": "String", "record": "Object" } },
    "tabChange": { "payload": { "tab": "String" } },
    "addAction": { "payload": { "action": "Object" } },
    "updateAction": { "payload": { "actionId": "String", "action": "Object" } },
    "deleteAction": { "payload": { "actionId": "String" } },
    "addModifier": { "payload": { "modifier": "Object" } },
    "deleteModifier": { "payload": { "index": "Number" } },
    "addContextNote": { "payload": { "contextNote": "Object" } },
    "deleteContextNote": { "payload": { "index": "Number" } },
    "updateCharges": { "payload": { "charges": "Object" } }
  },
  "slots": {
    "descriptionRichText": {},
    "unidentifiedRichText": {},
    "actionsSlot": {}
  }
}
