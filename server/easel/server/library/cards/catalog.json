        "shuffle(sequence,source)"
      ],
      "examples": [
        {
          "method": "shuffle",
          "args": [
            []
          ],
          "expected": []
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
