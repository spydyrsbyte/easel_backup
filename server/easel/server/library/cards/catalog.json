{
  "owner": "easel",
  "host": "cards",
  "description": "Independent card and collection presentations plus reusable card manipulations; no prescribed card-game rules.",
  "members": [
    {
      "name": "card",
      "side": "server",
      "version": 1,
      "description": "Card face/back, orientation and inspectable metadata operations on caller-selected records.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/card.mjs",
      "contract": "contracts/card.server.md",
      "methods": [
        "present(card,{faceUp=true,fields=[\"id\",\"name\",\"image\",\"description\",\"orientation\"]}={})",
        "orient(card,degrees)",
        "flip(card,allowed=true)"
      ],
      "examples": [
        {
          "method": "present",
          "args": [
            {
              "id": "a",
              "name": "Secret",
              "back": "back.jpg"
            },
            {
              "faceUp": false
            }
          ],
          "expected": {
            "id": "a",
            "faceUp": false,
            "back": "back.jpg"
          }
        },
        {
          "method": "flip",
          "args": [
            {},
            false
          ],
          "throws": true
        },
        {
          "method": "present",
          "args": [
            {
              "id": "x",
              "name": "Secret",
              "faceUp": false
            }
          ],
          "expected": {
            "id": "x",
            "faceUp": false,
            "back": null
          }
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "deck",
      "side": "server",
      "version": 1,
      "description": "Deck ordering, top/bottom insertion, draw/deal intents and shuffle of an ordered collection.",
      "status": "tested",
      "dependencies": [
        "Easel.Random"
      ],
      "entry": "server/deck.mjs",
      "contract": "contracts/deck.server.md",
      "methods": [
        "draw(members,count=1)",
        "insert(members,added,where=\"top\")",
        "deal(members,players,count=1)",
        "shuffle(members,source)"
      ],
      "examples": [
        {
          "method": "deal",
          "args": [
            [
              "a",
              "b",
              "c",
              "d"
            ],
            [
              "alice",
              "bob"
            ],
            2
          ],
          "expected": {
            "hands": {
              "alice": [
                "a",
                "c"
              ],
              "bob": [
                "b",
                "d"
              ]
            },
            "remaining": []
          }
        },
        {
          "method": "draw",
          "args": [
            [],
            1
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "hand",
      "side": "server",
      "version": 1,
      "description": "Hand-oriented presentation/order support, including hand visibility conventions.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/hand.mjs",
      "contract": "contracts/hand.server.md",
      "methods": [
        "reorder(members,order)",
        "project(cards,owner,viewer)"
      ],
      "examples": [
        {
          "method": "project",
          "args": [
            [
              {
                "id": "x",
                "name": "secret"
              }
            ],
            "alice",
            "bob"
          ],
          "expected": [
            {
              "id": "x",
              "faceUp": false,
              "back": null
            }
          ]
        },
        {
          "method": "reorder",
          "args": [
            [
              "a"
            ],
            [
              "b"
            ]
          ],
          "throws": true
        },
        {
          "method": "project",
          "args": [
            [
              {
                "id": "x",
                "name": "Secret"
              }
            ],
            null,
            null
          ],
          "expected": [
            {
              "id": "x",
              "faceUp": false,
              "back": null
            }
          ]
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "shuffle",
      "side": "server",
      "version": 1,
      "description": "Randomize a sequence using an approved server-side random source; no hard-coded card model.",
      "status": "tested",
      "dependencies": [
        "Easel.Random"
      ],
      "entry": "server/shuffle.mjs",
      "contract": "contracts/shuffle.server.md",
