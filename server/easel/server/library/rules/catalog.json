{
  "owner": "easel",
  "host": "rules",
  "description": "Small evaluation building blocks, not a general replacement for Easel automations or a universal rules engine.",
  "members": [
    {
      "name": "predicate",
      "side": "server",
      "version": 1,
      "description": "Evaluate reusable deterministic comparisons/conditions against supplied values.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/predicate.mjs",
      "contract": "contracts/predicate.server.md",
      "methods": [
        "evaluate(rule,context={},depth=0)"
      ],
      "examples": [
        {
          "method": "evaluate",
          "args": [
            {
              "op": "gte",
              "path": "life",
              "right": 3
            },
            {
              "life": 4
            }
          ],
          "expected": true
        },
        {
          "method": "evaluate",
          "args": [
            {
              "op": "eval"
            }
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "modifier",
      "side": "server",
      "version": 1,
      "description": "Compose ordered additive/multiplicative/override modifiers with explicit precedence.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/modifier.mjs",
      "contract": "contracts/modifier.server.md",
      "methods": [
        "apply(base,modifiers)"
      ],
      "examples": [
        {
          "method": "apply",
          "args": [
            2,
            [
              {
                "op": "add",
                "value": 3
              }
            ]
          ],
          "expected": {
            "value": 5,
            "applied": [
              {
                "id": "0",
                "before": 2,
                "after": 5
              }
            ]
          }
        },
        {
          "method": "apply",
          "args": [
            2,
            [
              {
                "op": "bad",
                "value": 1
              }
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "threshold",
      "side": "server",
      "version": 1,
      "description": "Evaluate success bands, degrees and graduated outcomes.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/threshold.mjs",
      "contract": "contracts/threshold.server.md",
      "methods": [
        "evaluate(value,bands)"
      ],
      "examples": [
        {
          "method": "evaluate",
          "args": [
            8,
            [
              {
                "min": 7,
                "id": "success"
              }
            ]
          ],
          "expected": {
            "min": 7,
            "id": "success",
            "value": 8,
            "margin": 1
          }
        },
        {
          "method": "evaluate",
          "args": [
            -1,
            [
              {
                "min": 0
              }
            ]
          ],
          "expected": null
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "lookup",
      "side": "server",
      "version": 1,
      "description": "Map rule symbols or statuses to resolved values.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/lookup.mjs",
      "contract": "contracts/lookup.server.md",
      "methods": [
        "resolve(table,symbol,fallback=null)"
      ],
      "examples": [
        {
          "method": "resolve",
          "args": [
            {
              "fire": 2
            },
            "fire"
          ],
          "expected": 2
        },
        {
          "method": "resolve",
          "args": [
            {},
            "ice"
          ],
          "expected": null
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "formula",
      "side": "server",
      "version": 1,
      "description": "Evaluate deterministic numeric expressions and extract variable dependencies.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/formula.mjs",
      "contract": "contracts/formula.server.md",
      "methods": [
        "evaluate(expression,context={})",
        "variables(expression)"
      ],
      "examples": [
        {
          "method": "evaluate",
          "args": [
            "floor((@abilities.str.total - 10) / 2) + (@level >= 4 ? 2 : 1)",
            {
              "abilities": {
                "str": {
                  "total": 18
                }
              },
              "level": 5
            }
          ],
          "expected": 6
        },
        {
          "method": "evaluate",
          "args": [
            "clamp(ceil(@a / 2) + round(@b) + abs(-3) + min(4, 2) + max(1, 5) + ifelse(@a == 3, 2, 10 / 0), 0, 12)",
            {
              "a": 3,
              "b": 1.6
            }
          ],
          "expected": 12
        },
        {
          "method": "variables",
          "args": [
            "clamp(@base + @bonus.value, 0, @base)"
          ],
          "expected": [
            "base",
            "bonus.value"
          ]
        },
        {
          "method": "evaluate",
          "args": [
            "10 / 0",
            {}
          ],
          "throws": true
        },
        {
          "method": "evaluate",
          "args": [
            "@missing + 1",
            {}
          ],
          "throws": true
        },
        {
          "method": "evaluate",
          "args": [
            "unknownFn(1)",
            {}
          ],
          "throws": true
        },
        {
          "method": "evaluate",
          "args": [
            "(1 + 2",
            {}
          ],
          "throws": true
        },
        {
          "method": "evaluate",
          "args": [
            "@toString",
            {},
            {
              "strict": false
            }
          ],
          "expected": 0
        },
        {
          "method": "variables",
          "args": [
            "unknownFn(@a)"
          ],
          "throws": true
        },
        {
          "method": "evaluate",
          "args": [
            "(((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((1)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))",
            {}
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "modifierlist",
      "side": "client",
      "version": 1,
      "description": "Explain applied bonuses, penalties and ordering.",
      "status": "tested",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/modifierlist.mjs",
      "contract": "interfaces/modifierlist.json",
      "renderer": "table",
      "checks": [
        "scripts/test-kit-browser.mjs"
      ],
      "documentation": "contracts/modifierlist.client.md",
      "events": [
        "close",
        "select",
        "change"
      ]
    },
    {
      "name": "outcome",
      "side": "client",
      "version": 1,
      "description": "Present success, failure and partial-success results.",
      "status": "tested",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/outcome.mjs",
      "contract": "interfaces/outcome.json",
      "renderer": "outcome",
      "checks": [
        "scripts/test-kit-browser.mjs"
      ],
      "documentation": "contracts/outcome.client.md",
      "events": [
        "close"
      ]
    },
    {
      "name": "condition",
      "side": "client",
      "version": 1,
      "description": "Display supplied rule conditions and why they hold/do not hold.",
      "status": "tested",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/condition.mjs",
      "contract": "interfaces/condition.json",
      "renderer": "conditions",
      "checks": [
        "scripts/test-kit-browser.mjs"
      ],
      "documentation": "contracts/condition.client.md",
      "events": [
        "close"
      ]
    }
  ]
}
