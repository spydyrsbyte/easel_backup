      ]
    },
    {
      "name": "gameboard",
      "side": "client",
      "version": 1,
      "description": "Grid game board with sliding pieces, click or drag moves, legal-move hints, last-move and marked squares, coordinates, keyboard play, and a flipped view.",
      "status": "used",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/gameboard.mjs",
      "contract": "interfaces/gameboard.json",
      "renderer": "gameboard",
      "checks": [
        "scripts/test-kit-browser.mjs"
      ],
      "documentation": "contracts/gameboard.client.md",
      "events": [
