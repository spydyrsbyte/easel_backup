      ]
    },
    {
      "name": "camera",
      "side": "client",
      "version": 1,
      "description": "Reusable camera pan/zoom/rotation/focus controls with change events.",
      "status": "used",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/camera.mjs",
      "contract": "interfaces/camera.json",
      "renderer": "camera",
      "checks": [
        "scripts/test-kit-browser.mjs",
        "TestTabletopMagicBrowser"
      ],
      "usedBy": [
        "easel.mtgtable.game"
      ],
      "documentation": "contracts/camera.client.md",
      "events": [
        "close",
        "select",
        "rotate",
        "zoom",
        "view"
      ]
    },
    {
      "name": "placement",
      "side": "client",
      "version": 1,
      "description": "Preview a proposed placement and emit a requested position.",
      "status": "tested",
      "dependencies": [
        "browser DOM"
      ],
      "entry": "client/placement.mjs",
      "contract": "interfaces/placement.json",
      "renderer": "placement",
      "checks": [
        "scripts/test-kit-browser.mjs"
      ],
      "documentation": "contracts/placement.client.md",
      "events": [
        "close",
