{
  "owner": "easel",
  "host": "actions",
  "description": "Candidate actions and decision presentation; no universal game action executor.",
  "members": [
    {
      "name": "availability",
      "side": "server",
      "version": 1,
      "description": "Evaluate caller-defined action availability from a provided context.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/availability.mjs",
      "contract": "contracts/availability.server.md",
      "methods": [
        "evaluate(actions,context={})"
      ],
      "examples": [
        {
          "method": "evaluate",
          "args": [
            [
              {
                "id": "buy"
              }
            ],
            {}
          ],
          "expected": [
            {
              "id": "buy",
              "available": true,
              "reasons": []
            }
          ]
        },
        {
          "method": "evaluate",
          "args": [
            [
              {
                "id": ""
              }
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "choice",
      "side": "server",
      "version": 1,
      "description": "Represent enumerated options, prerequisites and selection constraints.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/choice.mjs",
      "contract": "contracts/choice.server.md",
      "methods": [
        "validate(options,selected,{min=0,max=1}={})"
      ],
      "examples": [
        {
          "method": "validate",
          "args": [
            [
              "a",
              "b"
            ],
            [
              "b"
            ]
          ],
          "expected": [
            "b"
          ]
        },
        {
          "method": "validate",
          "args": [
            [
              "a"
            ],
            [
              "b"
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "targeting",
      "side": "server",
      "version": 1,
      "description": "Validate requested target shapes against caller-supplied allowed targets.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/targeting.mjs",
      "contract": "contracts/targeting.server.md",
      "methods": [
        "validate(targets,allowed,{min=1,max=1}={})"
      ],
      "examples": [
        {
          "method": "validate",
          "args": [
            [
              "a"
            ],
            [
              "a"
            ]
          ],
          "expected": [
            "a"
          ]
        },
        {
          "method": "validate",
          "args": [
            [
              "secret"
            ],
            [
              "a"
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "menu",
