      "methods": [
        "available(nodes,selected=[])"
      ],
      "examples": [
        {
          "method": "available",
          "args": [
            [
              {
                "id": "a"
              },
              {
                "id": "b",
                "requires": [
                  "a"
                ]
              }
            ],
            []
          ],
          "expected": [
            {
              "id": "a"
            }
          ]
        },
        {
          "method": "available",
          "args": [
            [
              {
                "id": "a",
                "requires": [
                  "a"
                ]
              }
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
