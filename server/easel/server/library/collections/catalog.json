{
  "owner": "easel",
  "host": "collections",
  "description": "Independent ordered/unordered member containers, membership queries and transfer primitives.",
  "members": [
    {
      "name": "ordered",
      "side": "server",
      "version": 1,
      "description": "Create, query, insert, remove and reorder members in an ordered container.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/ordered.mjs",
      "contract": "contracts/ordered.server.md",
      "methods": [
        "create(members=[])",
        "insert(members,id,index=members.length)",
        "remove(members,id)",
        "move(members,id,index)",
        "query(members,offset=0,count=members.length)"
      ],
      "examples": [
        {
          "method": "move",
          "args": [
            [
              "a",
              "b",
              "c"
            ],
            "a",
            2
          ],
          "expected": [
            "b",
            "c",
            "a"
          ]
        },
        {
          "method": "insert",
          "args": [
            [
              "a"
            ],
            "a"
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "set",
      "side": "server",
      "version": 1,
      "description": "Create, query, add and remove unordered unique membership.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/set.mjs",
      "contract": "contracts/set.server.md",
      "methods": [
        "create(members=[])",
        "add(members,id)",
        "remove(members,id)",
        "has(members,id)"
      ],
      "examples": [
        {
          "method": "add",
          "args": [
            [
              "a"
            ],
            "a"
          ],
          "expected": [
            "a"
          ]
        },
        {
          "method": "has",
          "args": [
            [
              "a"
            ],
            "b"
          ],
          "expected": false
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "transfer",
      "side": "server",
      "version": 1,
      "description": "Atomically move references between participating containers; do not duplicate membership ownership.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/transfer.mjs",
      "contract": "contracts/transfer.server.md",
      "methods": [
        "move(source,destination,id,index=destination.length)"
      ],
      "examples": [
        {
          "method": "move",
          "args": [
            [
              "a",
              "b"
            ],
            [
              "c"
            ],
            "a",
            0
          ],
          "expected": {
            "source": [
              "b"
            ],
            "destination": [
              "a",
              "c"
            ]
          }
        },
        {
          "method": "move",
          "args": [
            [
              "a"
            ],
            [
              "a"
            ],
            "a"
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "partition",
      "side": "server",
      "version": 1,
      "description": "Represent paged or partitioned collections without assuming one record per member or one record per game.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/partition.mjs",
      "contract": "contracts/partition.server.md",
      "methods": [
        "create(members,size=100)",
        "page(partition,index)",
        "locate(partition,id)"
      ],
      "examples": [
        {
          "method": "create",
          "args": [
            [
              "a",
              "b",
              "c"
            ],
            2
          ],
          "expected": {
            "size": 2,
            "total": 3,
            "pages": [
              [
                "a",
                "b"
              ],
              [
                "c"
              ]
            ]
          }
        },
        {
          "method": "create",
          "args": [
            [],
            0
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
