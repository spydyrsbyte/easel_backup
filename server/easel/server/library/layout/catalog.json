{
  "owner": "easel",
  "host": "layout",
  "description": "Containers and application layout widgets; rendering only unless the consumer elects to save layout preferences.",
  "members": [
    {
      "name": "workspace",
      "side": "server",
      "version": 1,
      "description": "Describe or validate a viewer's saved layout configuration; optional support for applications that persist layouts.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/workspace.mjs",
      "contract": "contracts/workspace.server.md",
      "methods": [
        "validate(value)",
        "fit(value,bounds)"
      ],
      "examples": [
        {
          "method": "validate",
          "args": [
            {
              "windows": []
            }
          ],
          "expected": {
            "windows": []
          }
        },
        {
          "method": "validate",
          "args": [
            {
              "windows": [
                {
                  "id": "w",
                  "x": 0,
                  "y": 0,
                  "width": -1,
                  "height": 2
                }
              ]
            }
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
