{
  "owner": "easel",
  "host": "narrative",
  "description": "Text/scene/story presentations and general collaborative note utilities.",
  "members": [
    {
      "name": "scene",
      "side": "server",
      "version": 1,
      "description": "Read/organize named scenes and references without imposing a storytelling process.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/scene.mjs",
      "contract": "contracts/scene.server.md",
      "methods": [
        "describe(scene)",
        "reorder(scenes,ids)"
      ],
      "examples": [
        {
          "method": "describe",
          "args": [
            {
              "id": "s"
            }
          ],
          "expected": {
            "id": "s",
            "title": "",
            "description": "",
            "participants": [],
            "references": []
          }
        },
        {
          "method": "reorder",
          "args": [
            [
              {
                "id": "s"
              }
            ],
            [
              "x"
            ]
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "journal",
      "side": "server",
      "version": 1,
      "description": "Format/search entry metadata supplied by the game.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/journal.mjs",
      "contract": "contracts/journal.server.md",
      "methods": [
        "search(entries,{query=\"\",tags=[],author=null}={})"
      ],
      "examples": [
        {
          "method": "search",
          "args": [
            [
              {
                "id": "a",
                "title": "Forest"
              }
            ],
            {
              "query": "forest"
            }
          ],
          "expected": [
            {
              "id": "a",
              "title": "Forest",
              "author": null,
              "time": null,
              "tags": []
            }
          ]
        },
        {
          "method": "search",
          "args": [
            [],
            {
              "query": 3
            }
          ],
          "throws": true
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
    {
      "name": "tags",
      "side": "server",
      "version": 1,
      "description": "Index/filter descriptive tags and relationships.",
      "status": "tested",
      "dependencies": [],
      "entry": "server/tags.mjs",
      "contract": "contracts/tags.server.md",
      "methods": [
        "index(entries)",
        "filter(entries,tags,{all=true}={})"
      ],
      "examples": [
        {
          "method": "index",
          "args": [
            [
              {
                "id": "a",
                "tags": [
                  "x"
                ]
              }
            ]
          ],
          "expected": {
            "x": [
              "a"
            ]
          }
        },
        {
          "method": "filter",
          "args": [
            [
              {
                "id": "a",
                "tags": [
                  "x"
                ]
              }
            ],
            [
              "y"
            ]
          ],
          "expected": []
        }
      ],
      "checks": [
        "scripts/test-kits.mjs",
        "internal/session/kit_test.go"
      ]
    },
