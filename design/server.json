{
    "library":{
        "entry":"./library/library-file.mjs"
        ,"required":{
            "modules":["<namespace>.<name>","<namespace>.<name>"]
            ,"interfaces":["<namespace>.<name>@#","<namespace>.<name>@#"]
        }
    }
    ,"security":{
        "entry":"./security/security-file.mjs"
        ,"required":{
            "modules":["<namespace>.<name>","<namespace>.<name>"]
        }
    }
    ,"application":{
        "entry":"./startup.mjs"
        ,"required":{
            "modules":["<namespace>.<name>","<namespace>.<name>"]
            ,"interfaces":["<namespace>.<name>@#","<namespace>.<name>@#"]
        }
    }
    ,"interfaces":[
        {"name":"<name>","versions":[1,2]},
        "<name>@#",
        {"name":"<name>@#","file":"./library/interfaces/name.mjs"},
        {"name":"<name>","file":"./library/interfaces/name.mjs","versions":[2,3]}
    ]
    ,"implements":[
        {"name":"<namespace>.<name>","versions":[1,2]},
        "<namespace>.<name>@#",
        {"name":"<namespace>.<name>@#","file":"./library/interfaces/name.mjs"},
        {"name":"<namespace>.<name>","file":"./library/interfaces/name.mjs","versions":[2,3]}
    ]
    ,"data":[
        {".name":"<name>","<field>":{".type":"string"}},
        {".modify":"<namespace>.<name>","<field>":{".type":"integer",".default":0}},
        {".name":"<name>",".extends":"<namespace>.<name>","<field>":{".type":"*<namespace>.<name>"}},
        {".file":"./data/types.json"}
    ]
}
